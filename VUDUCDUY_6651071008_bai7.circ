<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<project source="2.7.1" version="1.0">
  <lib desc="#Wiring" name="0"/>
  <lib desc="#Gates" name="1"/>
  <lib desc="#Memory" name="2"/>
  <main name="main"/>
  <options>
    <a name="gateUndefined" val="ignore"/>
    <a name="simlimit" val="1000"/>
    <a name="simrand" val="0"/>
  </options>
  <mappings/>
  <toolbar>
    <tool lib="0" name="Pin"><a name="tristate" val="false"/></tool>
    <tool lib="0" name="Pin"><a name="facing" val="west"/><a name="output" val="true"/></tool>
  </toolbar>
  <circuit name="main">
    <wire from="(160,100)" to="(220,100)"/>
    <wire from="(160,140)" to="(260,140)"/>
    <wire from="(260,140)" to="(260,180)"/>
    <wire from="(160,180)" to="(240,180)"/>
    <wire from="(240,140)" to="(240,180)"/>
    <wire from="(160,220)" to="(280,220)"/>
    <wire from="(280,140)" to="(280,220)"/>
    <wire from="(360,100)" to="(420,100)"/>
    <comp lib="0" loc="(160,100)" name="Pin"><a name="width" val="3"/><a name="tristate" val="false"/><a name="label" val="Addr[2:0]"/></comp>
    <comp lib="0" loc="(160,140)" name="Pin"><a name="width" val="4"/><a name="tristate" val="false"/><a name="label" val="Data_in[3:0]"/></comp>
    <comp lib="0" loc="(160,180)" name="Pin"><a name="tristate" val="false"/><a name="label" val="Load/Write"/></comp>
    <comp lib="0" loc="(160,220)" name="Clock"><a name="label" val="Clock"/></comp>
    <comp lib="2" loc="(360,100)" name="RAM">
      <a name="addrWidth" val="3"/>
      <a name="dataWidth" val="4"/>
      <a name="bus" val="separate"/>
    </comp>
    <comp lib="0" loc="(420,100)" name="Pin"><a name="facing" val="west"/><a name="output" val="true"/><a name="width" val="4"/><a name="label" val="Data_out[3:0]"/></comp>
  </circuit>
</project>