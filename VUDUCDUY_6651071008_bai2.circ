<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<project source="2.7.1" version="1.0">
  <lib desc="#Wiring" name="0"/>
  <lib desc="#Gates" name="1"/>
  <main name="main"/>
  <options>
    <a name="gateUndefined" val="ignore"/>
    <a name="simlimit" val="1000"/>
    <a name="simrand" val="0"/>
  </options>
  <mappings/>
  <toolbar>
    <tool lib="0" name="Pin"><a name="tristate" val="false"/></tool>
    <tool lib="0" name="Pin"><a name="facing" val="west"/><a name="output" val="true"/></tool>
  </toolbar>
  <circuit name="main">
    <wire from="(130,90)" to="(180,90)"/>
    <wire from="(130,130)" to="(180,130)"/>
    <wire from="(240,110)" to="(280,110)"/>
    <wire from="(130,170)" to="(280,170)"/>
    <wire from="(280,150)" to="(280,170)"/>
    <wire from="(330,130)" to="(390,130)"/>
    <comp lib="0" loc="(130,90)" name="Pin"><a name="tristate" val="false"/><a name="label" val="A"/></comp>
    <comp lib="0" loc="(130,130)" name="Pin"><a name="tristate" val="false"/><a name="label" val="B"/></comp>
    <comp lib="0" loc="(130,170)" name="Pin"><a name="tristate" val="false"/><a name="label" val="C"/></comp>
    <comp lib="1" loc="(240,110)" name="XOR Gate"/>
    <comp lib="1" loc="(330,130)" name="AND Gate"/>
    <comp lib="0" loc="(390,130)" name="Pin"><a name="facing" val="west"/><a name="output" val="true"/><a name="label" val="Y"/></comp>
  </circuit>
</project>