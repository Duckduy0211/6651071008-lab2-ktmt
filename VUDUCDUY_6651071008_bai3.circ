<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<project source="2.7.1" version="1.0">
  <lib desc="#Wiring" name="0"/>
  <lib desc="#Arithmetic" name="1"/>
  <main name="main"/>
  <options>
    <a name="gateUndefined" val="ignore"/>
    <a name="simlimit" val="1000"/>
    <a name="simrand" val="0"/>
  </options>
  <mappings/>
  <toolbar>
    <tool lib="0" name="Pin"><a name="tristate" val="false"/></tool>
    <tool lib="0" name="Pin"><a name="facing" val="west"/><a name="output" val="true"/></tool>
  </toolbar>
  <circuit name="main">
    <wire from="(160,110)" to="(220,110)"/>
    <wire from="(160,130)" to="(220,130)"/>
    <wire from="(240,140)" to="(240,190)"/>
    <wire from="(260,120)" to="(320,120)"/>
    <comp lib="0" loc="(160,110)" name="Pin"><a name="width" val="4"/><a name="tristate" val="false"/><a name="label" val="A[3:0]"/></comp>
    <comp lib="0" loc="(160,130)" name="Pin"><a name="width" val="4"/><a name="tristate" val="false"/><a name="label" val="B[3:0]"/></comp>
    <comp lib="1" loc="(260,120)" name="Adder"><a name="width" val="4"/></comp>
    <comp lib="0" loc="(320,120)" name="Pin"><a name="facing" val="west"/><a name="output" val="true"/><a name="width" val="4"/><a name="label" val="Sum[3:0]"/></comp>
    <comp lib="0" loc="(240,190)" name="Pin"><a name="facing" val="north"/><a name="output" val="true"/><a name="label" val="Cout"/></comp>
  </circuit>
</project>
