<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<project source="2.7.1" version="1.0">
  <lib desc="#Wiring" name="0"/>
  <lib desc="#Gates" name="1"/>
  <lib desc="#Arithmetic" name="2"/>
  <main name="main"/>
  <options>
    <a name="gateUndefined" val="ignore"/>
    <a name="simlimit" val="1000"/>
    <a name="simrand" val="0"/>
  </options>
  <mappings/>
  <toolbar>
    <tool lib="0" name="Pin"><a name="tristate" val="false"/></tool>
    <tool lib="0" name="Pin"><a name="facing" val="west"/><a name="output" val="true"/></tool>
  </toolbar>
  <circuit name="main">
    <wire from="(150,100)" to="(230,100)"/>
    <wire from="(150,140)" to="(170,140)"/>
    <wire from="(200,140)" to="(220,140)"/>
    <wire from="(220,110)" to="(220,140)"/>
    <wire from="(220,110)" to="(230,110)"/>
    <wire from="(270,100)" to="(340,100)"/>
    <wire from="(250,120)" to="(250,170)"/>
    <wire from="(250,170)" to="(270,170)"/>
    <wire from="(300,170)" to="(340,170)"/>
    <wire from="(250,60)" to="(250,90)"/>
    <comp lib="0" loc="(150,100)" name="Pin"><a name="width" val="4"/><a name="tristate" val="false"/><a name="label" val="A[3:0]"/></comp>
    <comp lib="0" loc="(150,140)" name="Pin"><a name="width" val="4"/><a name="tristate" val="false"/><a name="label" val="B[3:0]"/></comp>
    <comp lib="1" loc="(200,140)" name="NOT Gate"><a name="width" val="4"/></comp>
    <comp lib="2" loc="(270,100)" name="Adder"><a name="width" val="4"/></comp>
    <comp lib="0" loc="(250,60)" name="Constant"/>
    <comp lib="0" loc="(340,100)" name="Pin"><a name="facing" val="west"/><a name="output" val="true"/><a name="width" val="4"/><a name="label" val="Diff[3:0]"/></comp>
    <comp lib="1" loc="(300,170)" name="NOT Gate"/>
    <comp lib="0" loc="(340,170)" name="Pin"><a name="facing" val="west"/><a name="output" val="true"/><a name="label" val="Borrow"/></comp>
  </circuit>
</project>