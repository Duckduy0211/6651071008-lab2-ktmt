    <wire from="(380,100)" to="(420,100)"/>
    <wire from="(420,100)" to="(420,190)"/>
    <wire from="(420,190)" to="(460,190)"/>
    <wire from="(480,210)" to="(520,210)"/>
    <comp lib="0" loc="(100,100)" name="Clock"><a name="label" val="Clock"/></comp>
    <comp lib="0" loc="(100,160)" name="Pin"><a name="tristate" val="false"/><a name="label" val="Reset"/></comp>
    <comp lib="2" loc="(200,80)" name="J-K Flip-Flop"/>
    <comp lib="2" loc="(280,80)" name="J-K Flip-Flop"/>
    <comp lib="2" loc="(360,80)" name="J-K Flip-Flop"/>
