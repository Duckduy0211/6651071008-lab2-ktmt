<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<project source="2.7.1" version="1.0">
  <lib desc="#Wiring" name="0"/>
  <lib desc="#Gates" name="1"/>
  <lib desc="#Memory" name="2"/>
  <main name="main"/>
  <options>
    <a name="gateUndefined" val="ignore"/>
    <a name="simlimit" val="1000"/>
    <a name="simrand" val="0"/>
  </options>
  <mappings/>
  <toolbar>
    <tool lib="0" name="Pin"><a name="tristate" val="false"/></tool>
    <tool lib="0" name="Pin"><a name="facing" val="west"/><a name="output" val="true"/></tool>
  </toolbar>
  <circuit name="main">
    <wire from="(100,100)" to="(160,100)"/>
    <wire from="(100,160)" to="(160,160)"/>
    <wire from="(200,100)" to="(260,100)"/>
    <wire from="(160,120)" to="(160,160)"/>
    <wire from="(240,120)" to="(240,160)"/>
    <wire from="(160,160)" to="(240,160)"/>
    <wire from="(240,160)" to="(320,160)"/>
    <wire from="(320,160)" to="(400,160)"/>
    <wire from="(260,100)" to="(260,220)"/>
    <wire from="(260,220)" to="(460,220)"/>
    <wire from="(200,80)" to="(280,80)"/>
    <wire from="(280,80)" to="(280,210)"/>
    <wire from="(280,210)" to="(460,210)"/>
    <wire from="(280,100)" to="(340,100)"/>
    <wire from="(340,100)" to="(340,200)"/>
    <wire from="(340,200)" to="(460,200)"/>
    <wire from="(380,80)" to="(380,100)"/>
